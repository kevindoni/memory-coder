# Environment Configuration

# ====== MODE ======
# Mode/port ditentukan oleh peluncur (pm2 ecosystem.config.cjs), BUKAN di sini.
# - Bridge:  MEMORY_CODER_MODE=bridge MEMORY_CODER_PORT=3333 (via pm2)
# - MCP stdio: jalankan `node dist/index.js` TANPA env mode apa pun.
#   Jika bridge hidup, instance MCP otomatis jadi proxy HTTP (single-writer,
#   DB tidak dibuka); jika bridge mati, MCP membuka DB secara lokal.

# ====== SECURITY ======
# Set a strong random key to enable admin endpoint authentication
# If empty, admin endpoints are UNAUTHENTICATED (dev mode only)
MEMORY_CODER_API_KEY=your-secret-api-key-here

# ====== RATE LIMITING ======
# Requests per minute per IP
MEMORY_CODER_AI_RATE=20          # /v1/admin/ask, /capture
MEMORY_CODER_WRITE_RATE=120       # /remember, /log-bug, POST /memories

# ====== GIT INDEXER ======
# Auto-index git commits every N minutes (0 = disabled)
INDEXER_INTERVAL_MIN=360

# ====== LLM / OPENROUTER ======
# Required for AI features: /ask, /capture, smart-summary
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini

# LLM retry/timeout settings
LLM_MAX_RETRIES=2
LLM_TIMEOUT_MS=60000

# Backup LLM provider (optional, tried when OpenRouter fails)
# URL must be an OpenAI-compatible chat/completions endpoint
#LLM_BACKUP_NAME=backup
#LLM_BACKUP_URL=http://127.0.0.1:9000/v1/chat/completions
#LLM_BACKUP_API_KEY=your-backup-key
#LLM_BACKUP_MODEL=your-backup-model

# ====== DATABASE ======
# Override the SQLite database path (default: ./data/memory.db)
# Gunakan path ABSOLUT agar DB sama terlepas dari cwd proses
#MEMORY_DB_PATH=D:/path/ke/data/memory.db

# ====== SMART MANAGER ======
# Auto-detect/auto-register project from cwd on remember/log-bug
MC_AUTO_DETECT=true
# Near-duplicate detection threshold (0..1)
MC_DEDUP_THRESHOLD=0.9
# Auto-supersede older conflicting decisions
MC_AUTO_RESOLVE_CONFLICTS=true
# Stale-memory expiry: age window (days), max access count, dry-run default
MC_EXPIRE_DAYS=180
MC_EXPIRE_MIN_ACCESS=2
MC_EXPIRE_DRY_RUN=true
# Background maintenance tick interval in minutes
MC_SMART_INTERVAL_MIN=60

# ====== FILE WATCHER ======
# Directory to watch for conversation capture files
CAPTURES_DIR=./captures
