
# ====== DATABASE ======
# Override the SQLite database path (default: ./data/memory.db)
# Gunakan path ABSOLUT agar DB sama terlepas dari cwd proses
#MEMORY_DB_PATH=D:/path/ke/data/memory.db
# ====== SMART MANAGER ======
# Auto-detect/auto-register project from cwd on remember/log-bug
MC_AUTO_DETECT=true
# Near-duplicate detection threshold (0..1)
MC_DEDUP_THRESHOLD=0.9
# Auto-supersede older conflicting decisions
MC_AUTO_RESOLVE_CONFLICTS=true
# Stale-memory expiry: age window (days), max access count, dry-run default
MC_EXPIRE_DAYS=180
MC_EXPIRE_MIN_ACCESS=2
MC_EXPIRE_DRY_RUN=true
# Background maintenance tick interval in minutes
MC_SMART_INTERVAL_MIN=60
# ====== FILE WATCHER ======
# Directory to watch for conversation capture files
CAPTURES_DIR=./captures